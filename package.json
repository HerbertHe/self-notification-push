{
  "name": "self-notification-push",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.9.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250902.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.34.0"
  },
  "cloudflare": {
    "label": "Bark Server (Hono)",
    "products": ["Workers", "D1"],
    "categories": [],
    "icon_urls": [],
    "docs_url": "https://developers.cloudflare.com/workers/",
    "bindings": {
      "BACKDOOR_API_KEY": {
        "description": "High-entropy admin secret for managing source whitelist keys. Generate with: openssl rand -hex 32"
      }
    },
    "dash": true
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.32.1"
}
